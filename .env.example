# Skopíruj do .env.local a doplň hodnoty. .env.local sa necommituje.
# Premenné sa čítajú pri builde aj za behu servera; po zmene reštartuj dev server
# a v produkcii spusti nový build.

# ── Web ────────────────────────────────────────────────────────────────────────
# Verejná adresa (odkazy v e-mailoch, canonical URL, Open Graph, sitemap).
# Na Verceli sa bez nej použije VERCEL_PROJECT_PRODUCTION_URL.
SITE_URL=http://localhost:3000

# open = registrácia otvorená; waitlist = namiesto registrácie zápis na early access.
SIGNUP_MODE=open

# ── Supabase (databáza, prihlasovanie, úložisko) ─────────────────────────────
# Project Settings → API Keys. Publishable kľúč je verejný (chráni ho RLS).
NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...
# Staršie projekty: NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Secret kľúč patrí IBA na server. Nikdy mu nedávaj prefix NEXT_PUBLIC_.
SUPABASE_URL=https://<project-ref>.supabase.co
SUPABASE_SECRET_KEY=sb_secret_...
# Staršie projekty: SUPABASE_SERVICE_ROLE_KEY=

# ── AI ────────────────────────────────────────────────────────────────────────
# Anthropic (Claude): analýza podkladov, reporty, nápoveda, textový režim, cvičenia.
ANTHROPIC_API_KEY=
# Voliteľné: iný model (predvolený claude-opus-5-5).
# ANTHROPIC_MODEL=claude-opus-5-5
# ANTHROPIC_FAST_MODEL=claude-opus-5-5

# OpenAI Realtime: živý hlasový rozhovor a prepis reči.
OPENAI_API_KEY=
# Voliteľné (predvolené hodnoty):
# OPENAI_REALTIME_MODEL=gpt-realtime-2.1
# OPENAI_TRANSCRIPTION_MODEL=gpt-4o-transcribe
# OPENAI_REALTIME_VOICE=cedar

# ── Platby (voliteľné) ────────────────────────────────────────────────────────
# Bez týchto premenných platby nie sú zapnuté a aplikácia to povie.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_ID_PRO=

# ── Bezpečnosť a prevádzkovateľ ──────────────────────────────────────────────
# Tajomstvo na HMAC (hash IP pri limitoch, pseudonym používateľa pre poskytovateľa AI).
# Vygeneruj: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
IP_HASH_SALT=

# Kontakt a prevádzkovateľ (pätička, právne stránky). Pred spustením povinné.
CONTACT_EMAIL=
LEGAL_ENTITY_NAME=
LEGAL_ENTITY_ID=
LEGAL_ENTITY_ADDRESS=
